# ===== 电智学伴 Phase 2 环境配置示例 =====
# 使用方法：复制本文件为 .env（与 main.py 同目录），填入真实 Key。
# 注意：.env 含密钥，不要提交到 git / 不要发给别人。

# 必填：Moonshot (Kimi) API Key
# 获取：https://platform.moonshot.cn 注册 -> 个人中心 -> API Key 管理
KIMI_API_KEY=sk-在这里粘贴你的Key

# 可选：默认即可，一般无需修改
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 模型名以 Moonshot 平台当前可用模型为准（2026-09-03 实测可用：kimi-k2.6）
KIMI_MODEL=kimi-k2.6

# 可选：服务端口
PORT=8000

# ---- Phase 2 RAG（可选配置，默认即可） ----
# 首次运行 bge-small-zh 需从 HuggingFace 下载约 100MB 模型。
# 国内网络慢时设置镜像：HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com
